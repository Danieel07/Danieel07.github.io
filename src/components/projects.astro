---
interface Project {
  id: string;
  title: string;
  status: string;
  description: string;
  tags: string[];
  link: string;
  gradient: string;
  accentColor: string;
  statusColor: string;
}

const projects: Project[] = [
  {
    id: "midaxus",
    title: "Midaxus 1.0",
    status: "Completado",
    description:
      "Plataforma web de gestión académica integral con control multi-rol, asignación inteligente de horarios y autenticación segura con JWT.",
    tags: ["Java", "JWT", "Clean Architecture"],
    link: "https://github.com/Danieel07/Midaxus-1.0",
    gradient: "from-[#201538] via-[#14111d] to-[#0c0a12]",
    accentColor: "#a476ff",
    statusColor: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
  },
  {
    id: "pokedex",
    title: "Pokédex",
    status: "Completado",
    description:
      "Aplicación desarrollada en Java orientada a la gestión de datos de Pokémon mediante operaciones CRUD completas (crear, leer, actualizar y eliminar).",
    tags: ["Java", "POO", "CRUD"],
    link: "https://github.com/Danieel07/Pokedex",
    gradient: "from-[#2d141e] via-[#191017] to-[#0c0a12]",
    accentColor: "#f43f5e",
    statusColor: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
  },
  {
    id: "invasion-espacial",
    title: "Invasión Espacial",
    status: "Completado",
    description:
      "Recreación del clásico videojuego arcade Space Invaders con mecánicas interactivas y renderizado gráfico desarrollado en Python y Pygame.",
    tags: ["Python", "Pygame"],
    link: "https://github.com/Danieel07/Invasion_Espacial",
    gradient: "from-[#122338] via-[#0f1724] to-[#0c0a12]",
    accentColor: "#38bdf8",
    statusColor: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
  },
  {
    id: "motogo",
    title: "MotoGO",
    status: "En desarrollo",
    description:
      "Plataforma y ecosistema de alquiler ágil de motocicletas urbanas orientada a movilidad eficiente y servicios bajo demanda.",
    tags: ["Java", "Spring Boot", "REST API"],
    link: "https://github.com/Danieel07",
    gradient: "from-[#2a1f10] via-[#1a1510] to-[#0c0a12]",
    accentColor: "#fbbf24",
    statusColor: "bg-amber-500/10 text-amber-300 border-amber-500/20",
  },
];
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec" data-i18n="projects.badge">Mi trabajo</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8" data-i18n="projects.title">Proyectos</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        projects.map((project, index) => (
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col bg-[#1414149c] border border-[var(--white-icon-tr)] hover:border-[#ffffff25] rounded-3xl p-5 md:p-6 transition-all duration-300 hover:shadow-2xl hover:shadow-[#a476ff12] hover:-translate-y-1.5 focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
          >
            <!-- Preview Banner Container with Central Project Name -->
            <div class="relative w-full h-48 md:h-56 rounded-2xl overflow-hidden border border-[#ffffff12] bg-[#0c0a12] flex items-center justify-center mb-5 group-hover:border-[#ffffff28] transition-all duration-300">
              <div class={`absolute inset-0 bg-gradient-to-br ${project.gradient} opacity-90 group-hover:opacity-100 transition-opacity duration-300`}></div>
              <div class="absolute inset-0 opacity-30 bg-[linear-gradient(to_right,#ffffff0a_1px,transparent_1px),linear-gradient(to_bottom,#ffffff0a_1px,transparent_1px)] bg-[size:24px_24px]"></div>
              <div
                class="absolute w-40 h-40 rounded-full blur-2xl opacity-20 group-hover:opacity-40 transition-opacity duration-500 pointer-events-none"
                style={`background-color: ${project.accentColor};`}
              ></div>

              <div class="relative z-10 flex flex-col items-center justify-center px-6 text-center">
                <span
                  class="text-2xl md:text-3xl font-bold tracking-tight text-white group-hover:text-[var(--sec)] group-hover:scale-105 transition-all duration-300 drop-shadow-md"
                  data-i18n={`projects.items.${index}.title`}
                >
                  {project.title}
                </span>
                <span class="mt-2 text-xs font-mono text-[var(--white-icon)] tracking-wider">
                  {project.tags.join(" • ")}
                </span>
              </div>
            </div>

            <!-- Card Content -->
            <div class="flex flex-col flex-grow">
              <!-- Header: Title, Status and Arrow Button -->
              <div class="flex items-start justify-between gap-3 mb-3">
                <div>
                  <h4
                    class="text-xl md:text-2xl font-semibold text-[var(--white)] group-hover:text-white transition-colors duration-200"
                    data-i18n={`projects.items.${index}.title`}
                  >
                    {project.title}
                  </h4>
                  <span
                    class={`inline-block mt-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium border ${project.statusColor}`}
                    data-i18n={`projects.items.${index}.status`}
                  >
                    {project.status}
                  </span>
                </div>

                <!-- Single ↗ Arrow Button -->
                <div
                  aria-label={`Ver repositorio de ${project.title}`}
                  class="size-12 flex-shrink-0 flex justify-center items-center text-[var(--white-icon)] group-hover:text-white group-hover:bg-[var(--white-icon-tr)] group-hover:border-[#ffffff30] group-hover:scale-105 transition-all duration-300 border border-[var(--white-icon-tr)] rounded-xl bg-[#1414149c]"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="size-6 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  >
                    <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                  </svg>
                </div>
              </div>

              <!-- Description -->
              <p
                class="text-sm md:text-base text-[var(--white-icon)] leading-relaxed mb-4 flex-grow"
                data-i18n={`projects.items.${index}.description`}
              >
                {project.description}
              </p>

              <!-- Tags -->
              <div class="flex flex-wrap gap-2 pt-3 border-t border-[#ffffff0a] mt-auto">
                {project.tags.map((tag) => (
                  <span class="px-3 py-1 text-xs font-medium rounded-lg bg-[#ffffff06] text-[var(--white-icon)] border border-[var(--white-icon-tr)]">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </a>
        ))
      }
    </div>
    <a
      target="_blank"
      rel="noopener noreferrer"
      href="https://github.com/Danieel07"
      aria-label="GitHub"
      class="w-full flex items-center justify-center gap-2 mt-9 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-[1.02]"
    >
      <span class="md:text-lg text-md" data-i18n="projects.moreOn">Más proyectos en</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="size-6"
      >
        <path
          d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
      ></path>
    </svg>
  </a>
</section>
